# ── Phase 1 (frontend + mock data) ────────────────────────────────────────────
# These four are the ONLY variables needed to run the entire frontend.

# Data layer implementation: "mock" (in-memory) or "kv" (Phase 5, Vercel KV)
NEXT_PUBLIC_DATA_SOURCE=mock

# Canonical site URL — used for metadata, Open Graph, sitemap, hreflang.
# Must match the dev/start port in package.json (3030), or canonical URLs and
# the sitemap will point at a port nothing is listening on.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Public contact channels
NEXT_PUBLIC_CONTACT_EMAIL=studio@qorv.id
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# ── Admin panel ───────────────────────────────────────────────────────────────
# The panel has one operator account, so there is no user table.
# ADMIN_EMAIL + ADMIN_PASSWORD seed the first `dev` user on boot; ADMIN_SECRET
# signs the session cookie. Once the panel is running, further users are created
# in Admin > Users and their passwords are stored as scrypt hashes, never plain.
# Both are REQUIRED in production - the app refuses to start without them.
# In development they fall back to the values below.
ADMIN_EMAIL=studio@qorv.id
ADMIN_PASSWORD=qorv-admin
ADMIN_SECRET=qorv-development-secret-not-for-production

# ── Phase 5 (Vercel KV backend) — not required yet ────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# RESEND_API_KEY=
