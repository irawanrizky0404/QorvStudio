{
  "name": "qorv-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3030",
    "build": "next build",
    "start": "next start --port 3030",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/unit.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "logos": "node --import tsx scripts/make-logos.tsx",
    "backup": "node --import tsx --env-file-if-exists=.env.local scripts/backup.ts",
    "import:work": "node --import tsx scripts/import-work-images.ts",
    "product:covers": "node --import tsx scripts/make-product-covers.tsx",
    "product:shots": "node --import tsx scripts/capture-product-shots.ts",
    "product:profile": "node --import tsx scripts/open-shot-profile.ts",
    "product:shots:auth": "node --import tsx scripts/capture-product-shots.ts --authed"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.6.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "lucide-react": "1.28.0",
    "nanoid": "6.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "server-only": "0.0.1",
    "swr": "2.4.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "playwright": "1.62.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "typescript": "6.0.3"
  }
}
